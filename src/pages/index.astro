---
import Base from '../layouts/Base.astro'
import Install from '../components/react/Install'
import Stack from '../components/solid/Index'
import Theme from '../components/svelte/Theme.svelte'
import Nav from '../components/vue/Nav.vue'
import { counts } from '../data/packages'

const tagline = 'A stack of MoonBit libraries: web services, data, protocols, surfaces and inference.'
---

<Base title="moonbitstack" description={tagline}>
  <header class="hero">
    <img src="/moonkits.png" alt="moonbitstack logo" width="108" height="108" />
    <div class="name">
      <h1>moonbitstack</h1>
      <p class="tagline">{tagline}</p>
      <Install client:idle />
      <p class="links">
        <a href="https://github.com/moonbitstack">github</a>
        <a href="https://mooncakes.io/user/moonbitstack">mooncakes</a>
        <a href="https://www.moonbitlang.com/">moonbit</a>
        <Theme client:idle />
      </p>
    </div>
    <p class="tally">
      {counts.all} modules in all. {counts.published} are published, {counts.lts} of them on long-term
      support. {counts.planned} have their design settled and no release yet. Two are not published: the template every repository starts
      from, and an example that runs nine of them at once.
    </p>
  </header>

  <div class="sheet">
    <Nav client:idle />
    <div class="body">
      <Stack client:idle />
    </div>
  </div>

  <footer>
    Everything here is Apache-2.0, published on mooncakes under <code>moonbitstack/</code>, and
    developed at <a href="https://github.com/moonbitstack">github.com/moonbitstack</a>. A module
    marked <em>LTS</em> has a settled interface: its later releases fix bugs. A
    module marked <em>in design</em> has a written specification and no release yet.
  </footer>
</Base>
